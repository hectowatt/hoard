{
  "name": "hoard",
  "version": "1.1.3",
  "type": "module",
  "private": true,
  "description": "Hoard root",
  "workspaces": [
    "packages/frontend",
    "packages/backend"
  ],
  "scripts": {
    "dev": "node start.js dev",
    "build": "npm run build -w packages/frontend && npm run build -w packages/backend",
    "start": "node start.js prod",
    "test": "npm run test -w packages/frontend && npm run test -w packages/backend",
    "migrate": "npm run migrate -w packages/backend",
    "typeorm": "npm run typeorm -w packages/backend",
    "generate": "npm run generate -w packages/backend"
  },
  "devDependencies": {
    "tsx": "^4.21.0"
  },
  "dependencies": {
    "concurrently": "^9.2.1"
  }
}